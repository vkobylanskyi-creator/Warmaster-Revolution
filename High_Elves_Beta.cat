        <!-- ========================= -->
        <!--    ARCHERS                -->
        <!-- ========================= -->

            <selectionEntry
                id="unit-archers"
                name="Archers"
                hidden="false"
                type="unit"
                import="true">

                <profiles>
                    <profile
                        id="prof-archers"
                        name="Archers"
                        hidden="false"
                        typeId="unit-profile"
                        typeName="Unit Profile">
    
                        <characteristics>
                            <characteristic
                                id="char-value-att-archers"
                                typeId="char-att"
                                name="Attacks">3/1
                            </characteristic>
    
                            <characteristic
                                id="char-value-range-archers"
                                typeId="char-range"
                                name="Range">30cm
                            </characteristic>

                            <characteristic
                                id="char-value-hits-archers"
                                typeId="char-hits"
                                name="Hits">3
                            </characteristic>

                            <characteristic
                                id="char-value-arm-archers"
                                typeId="char-arm"
                                name="Armor">6+
                            </characteristic>

                            <characteristic
                                id="char-value-size-archers"
                                typeId="char-size"
                                name="Size">3
                            </characteristic>

                            <characteristic
                                id="char-value-special-archers"
                                typeId="char-special"
                                name="Special Rules">Archers. High Elf archers add +1 to their dice rolls when making Shooting attacks. They will therefore score a hit against targets in the open on a 3 or more, against targets that are defended on a 4 or more, and against fortified targets on a 5 or more.
                            </characteristic>
                        </characteristics>
                    </profile>
                </profiles>

                <costs>
                    <cost
                        id="cost-archers"
                        typeId="points"
                        name="pts"
                        value="75.0"/>
                    </costs>
                
                <categoryLinks>
                    <categoryLink
                        id="category-archers"
                        name="Infantry"
                        targetId="cat-inf"
                        primary="true"
                        hidden="false"/>
                </categoryLinks>
            </selectionEntry>

        <!-- ========================= -->
        <!--    BETA SWORDMASTERS       -->
        <!-- ========================= -->

        <selectionEntry
            id="unit-swordmasters"
            name="Spearmen  [BETA]"
            hidden="false"
            type="unit"
            import="true">

            <profiles>
                <profile
                    id="prof-swordmasters"
                    name="Swordmasters [BETA]"
                    hidden="false"
