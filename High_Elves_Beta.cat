<?xml version="1.0" encoding="UTF-8" standalone="yes"?>

<catalogue
    library="false"
    id="he-beta-cat"
    name="High Elves (Beta)"
    gameSystemId="wmr-sys"
    gameSystemRevision="1"
    revision="1"
    battleScribeVersion="2.03"
    type="catalogue"
    xmlns="http://www.battlescribe.net/schema/catalogueSchema">

  <sharedSelectionEntries>

    <selectionEntry
        id="unit-spearmen"
        name="Spearmen"
        hidden="false"
        type="unit"
        import="true">

      <profiles>

        <profile
            id="prof-spearmen"
            name="Spearmen"
            hidden="false"
            typeId="unit-profile"
            typeName="Unit Profile">

          <characteristics>

            <characteristic
                id="char-value-att"
                typeId="char-att"
                name="Attacks">3</characteristic>

            <characteristic
                id="char-value-hits"
                typeId="char-hits"
                name="Hits">3</characteristic>

            <characteristic
                id="char-value-arm"
                typeId="char-arm"
                name="Armor">5+</characteristic>

            <characteristic
                id="char-value-size"
                typeId="char-size"
                name="Size">3</characteristic>

          </characteristics>

        </profile>

      </profiles>

      <costs>

        <cost
            id="cost-spearmen"
            typeId="points"
            name="pts"
            value="60.0"/>

      </costs>

      <categoryLinks>

        <categoryLink
            id="category-spearmen"
            name="Infantry"
            targetId="cat-inf"
            primary="true"
            hidden="false"/>

      </categoryLinks>

    </selectionEntry>

<selectionEntry
    id="unit-archers"
    name="Archers"
    hidden="false"
    type="unit"
    import="true">

    <profiles>

        <profile
            id="prof-archers"
            name="Archers"
            hidden="false"
            typeId="unit-profile"
            typeName="Unit Profile">

            <characteristics>

                <characteristic
                    id="char-value-att-archers"
                    typeId="char-att"
                    name="Attacks">3/1</characteristic>

                <characteristic
                    id="char-value-hits-archers"
                    typeId="char-hits"
                    name="Hits">3</characteristic>

                <characteristic
                    id="char-value-arm-archers"
                    typeId="char-arm"
                    name="Armor">6+</characteristic>

                <characteristic
                    id="char-value-size-archers"
                    typeId="char-size"
                    name="Size">3</characteristic>

            </characteristics>

        </profile>

    </profiles>

    <costs>

        <cost
            id="cost-archers"
            typeId="points"
            name="pts"
            value="75.0"/>

    </costs>

    <categoryLinks>

        <categoryLink
            id="category-archers"
            name="Infantry"
            targetId="cat-inf"
            primary="true"
            hidden="false"/>

    </categoryLinks>

</selectionEntry>

  </sharedSelectionEntries>

  <entryLinks>

    <entryLink
        id="link-spearmen"
        name="Spearmen"
        hidden="false"
        type="selectionEntry"
        targetId="unit-spearmen"
        import="true"/>

<entryLink
    id="link-archers"
    name="Archers"
    hidden="false"
    type="selectionEntry"
    targetId="unit-archers"
    import="true"/>

  </entryLinks>

</catalogue>
