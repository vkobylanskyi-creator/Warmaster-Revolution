<?xml version="1.0" encoding="UTF-8" standalone="yes"?>

<catalogue
    library="false"
    id="he-beta-cat"
    name="High Elves (Beta)"
    gameSystemId="wmr-sys"
    gameSystemRevision="2"
    revision="2"
    battleScribeVersion="2.03"
    type="catalogue"
    xmlns="http://www.battlescribe.net/schema/catalogueSchema">

    <sharedSelectionEntries>

        <selectionEntry
            id="unit-spearmen"
            name="Spearmen"
            hidden="false"
            type="unit"
            import="true">

            <profiles>

                <profile
                    id="prof-spearmen"
                    name="Spearmen"
                    hidden="false"
                    typeId="unit-profile"
                    typeName="Unit Profile">

                    <characteristics>

                        <characteristic
                            id="char-value-att-spearmen"
                            typeId="char-att"
                            name="Attacks">3</characteristic>

                        <characteristic
                            id="char-value-hits-spearmen"
                            typeId="char-hits"
                            name="Hits">3</characteristic>

                        <characteristic
                            id="char-value-arm-spearmen"
                            typeId="char-arm"
                            name="Armor">5+</characteristic>

                        <characteristic
                            id="char-value-size-spearmen"
                            typeId="char-size"
                            name="Size">3</characteristic>

                    </characteristics>

                </profile>

            </profiles>

            <costs>

                <cost
                    id="cost-spearmen"
                    typeId="points"
                    name="pts"
                    value="60.0"/>

            </costs>

            <categoryLinks>

                <categoryLink
                    id="category-spearmen"
                    name="Infantry"
                    targetId="cat-inf"
                    primary="true"
                    hidden="false"/>

            </categoryLinks>

        </selectionEntry>


        <selectionEntry
            id="unit-archers"
            name="Archers"
            hidden="false"
            type="unit"
            import="true">

            <profiles>

                <profile
                    id="prof-archers"
                    name="Archers"
                    hidden="false"
                    typeId="unit-profile"
                    typeName="Unit Profile">

                    <characteristics>

                        <characteristic
                            id="char-value-att-archers"
                            typeId="char-att"
                            name="Attacks">3/1</characteristic>

                        <characteristic
                            id="char-value-range-archers"
                            typeId="char-range"
                            name="Range">30cm</characteristic>

                        <characteristic
                            id="char-value-hits-archers"
                            typeId="char-hits"
                            name="Hits">3</characteristic>

                        <characteristic
                            id="char-value-arm-archers"
                            typeId="char-arm"
                            name="Armor">6+</characteristic>

                        <characteristic
                            id="char-value-size-archers"
                            typeId="char-size"
                            name="Size">3</characteristic>

                        <characteristic
                            id="char-value-special-archers"
                            typeId="char-special"
                            name="Special Rules">Archers. High Elf archers add +1 to their dice rolls when making Shooting attacks. They will therefore score a hit against targets in the open on a 3 or more, against targets that are defended on a 4 or more, and against fortified targets on a 5 or more.</characteristic>

                    </characteristics>

                </profile>

            </profiles>

            <costs>

                <cost
                    id="cost-archers"
                    typeId="points"
                    name="pts"
                    value="75.0"/>

            </costs>

            <categoryLinks>

                <categoryLink
                    id="category-archers"
                    name="Infantry"
                    targetId="cat-inf"
                    primary="true"
                    hidden="false"/>

            </categoryLinks>

        </selectionEntry>

    </sharedSelectionEntries>


    <!-- ========================= -->
    <!-- BATTLE SIZE               -->
    <!-- ========================= -->

    <sharedSelectionEntryGroups>

        <selectionEntryGroup
            id="battle-size-group"
            name="Battle Size"
            hidden="false"
            collective="false"
            import="true">

<constraints>

    <constraint
        id="battle-size-min"
        field="selections"
        scope="parent"
        value="1"
        type="min"
        percentValue="false"/>

    <constraint
        id="battle-size-max"
        field="selections"
        scope="parent"
        value="1"
        type="max"
        percentValue="false"/>

</constraints>

            <selectionEntries>

                <selectionEntry
                    id="battle-small"
                    name="1000 pts — Small Battle"
                    hidden="false"
                    type="upgrade"
                    import="true">

                    <costs>
                        <cost
                            id="cost-battle-small"
                            typeId="points"
                            name="pts"
                            value="0.0"/>
                    </costs>

<modifiers>

    <modifier
        id="modifier-small-spearmen-min"
        type="set"
        field="min"
        value="2">

        <conditions>

            <condition
                field="selections"
                scope="roster"
                value="1"
                percentValue="false"
                shared="false"
                includeChildSelections="true"
                includeChildForces="false"
                childId="battle-small"
                type="instanceOf"/>

        </conditions>

    </modifier>

</modifiers>

                </selectionEntry>

                <selectionEntry
                    id="battle-standard"
                    name="2000 pts — Standard Battle"
                    hidden="false"
                    type="upgrade"
                    import="true">

                    <costs>
                        <cost
                            id="cost-battle-standard"
                            typeId="points"
                            name="pts"
                            value="0.0"/>
                    </costs>

                </selectionEntry>

                <selectionEntry
                    id="battle-large"
                    name="3000 pts — Large Battle"
                    hidden="false"
                    type="upgrade"
                    import="true">

                    <costs>
                        <cost
                            id="cost-battle-large"
                            typeId="points"
                            name="pts"
                            value="0.0"/>
                    </costs>

                </selectionEntry>

                <selectionEntry
                    id="battle-grand"
                    name="4000 pts — Grand Battle"
                    hidden="false"
                    type="upgrade"
                    import="true">

                    <costs>
                        <cost
                            id="cost-battle-grand"
                            typeId="points"
                            name="pts"
                            value="0.0"/>
                    </costs>

                </selectionEntry>

                <selectionEntry
                    id="battle-massive"
                    name="5000 pts — Massive Battle"
                    hidden="false"
                    type="upgrade"
                    import="true">

                    <costs>
                        <cost
                            id="cost-battle-massive"
                            typeId="points"
                            name="pts"
                            value="0.0"/>
                    </costs>

                </selectionEntry>

            </selectionEntries>

        </selectionEntryGroup>

    </sharedSelectionEntryGroups>


    <entryLinks>

        <entryLink
            id="link-battle-size"
            name="Battle Size"
            hidden="false"
            collective="false"
            import="true"
            type="selectionEntryGroup"
            targetId="battle-size-group"/>

        <entryLink
            id="link-spearmen"
            name="Spearmen"
            hidden="false"
            type="selectionEntry"
            targetId="unit-spearmen"
            import="true"/>

        <entryLink
            id="link-archers"
            name="Archers"
            hidden="false"
            type="selectionEntry"
            targetId="unit-archers"
            import="true"/>

    </entryLinks>

</catalogue>
