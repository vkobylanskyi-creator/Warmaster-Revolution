<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<catalogue
    library="false"
    id="he-beta-cat"
    name="High Elves (Beta)"
    gameSystemId="wmr-sys"
    gameSystemRevision="2"
    revision="2"
    battleScribeVersion="2.03"
    type="catalogue"
    xmlns="http://www.battlescribe.net/schema/catalogueSchema">

    <sharedSelectionEntries>
        <!-- ========================= -->
        <!-- PROFILES                  -->
        <!--    GENERAL                -->
        <!-- ========================= -->

        <selectionEntry
            id="unit-general"
            name="General"
            hidden="false"
            type="unit"
            import="true">

            <profiles>
                <profile
                    id="prof-general"
                    name="General"
                    hidden="false"
                    typeId="unit-profile"
                    typeName="Unit Profile">

                    <characteristics>
                        <characteristic
                            id="char-value-att-general"
                            typeId="char-att"
                            name="Attacks">+2
                        </characteristic>

                        <characteristic
                            id="char-value-com-general"
                            typeId="char-com"
                            name="Command">10
                        </characteristic>

                        <characteristic
                            id="char-value-size-general"
                            typeId="char-size"
                            name="Size">1
                        </characteristic>
                
                    </characteristics>
                </profile>
            </profiles>

            <costs>
                <cost
                    id="cost-general"
                    typeId="points"
                    name="pts"
                    value="180.0"/>
            </costs>

            <categoryLinks>
                <categoryLink
                    id="category-general"
                    name="Characters"
                    targetId="cat-char"
                    primary="true"
                    hidden="false"/>
            </categoryLinks>

            <constraints>
                <constraint
                    id="min-general"
                    field="selections"
                    scope="roster"
                    value="1"
                    type="min"
                    percentValue="false"/>

                <constraint
                    id="max-general"
                    field="selections"
                    scope="roster"
                    value="1"
                    type="max"
                    percentValue="false"/>
            </constraints>
        </selectionEntry>

        <!-- ========================= -->
        <!--    SPEARMEN               -->
        <!-- ========================= -->

        <selectionEntry
            id="unit-spearmen"
            name="Spearmen"
            hidden="false"
            type="unit"
            import="true">

            <profiles>
                <profile
                    id="prof-spearmen"
                    name="Spearmen"
                    hidden="false"
                    typeId="unit-profile"
                    typeName="Unit Profile">

                    <characteristics>
                        <characteristic
                            id="char-value-att-spearmen"
                            typeId="char-att"
                            name="Attacks">3
                        </characteristic>

                        <characteristic
                            id="char-value-hits-spearmen"
                            typeId="char-hits"
                            name="Hits">3
                        </characteristic>

                        <characteristic
                            id="char-value-arm-spearmen"
                            typeId="char-arm"
                            name="Armor">5+
                        </characteristic>

                        <characteristic
                            id="char-value-size-spearmen"
                            typeId="char-size"
                            name="Size">3
                        </characteristic>
                    </characteristics>
                </profile>
            </profiles>

            <costs>
                <cost
                    id="cost-spearmen"
                    typeId="points"
                    name="pts"
                    value="60.0"/>
                </costs>
            
                <categoryLinks>
                    <categoryLink
                        id="category-spearmen"
                        name="Infantry"
                        targetId="cat-inf"
                        primary="true"
                        hidden="false"/>
                </categoryLinks>
                
                <constraints>
                    <constraint
                        id="min-spearmen"
                        field="selections"
                        scope="roster"
                        value="0"
                        type="min"
                        percentValue="false"/>
                </constraints>
                
                <modifiers>
                    <modifier
                        id="modifier-spearmen-small-battle"
                        type="set"
                        field="min-spearmen"
                        value="2">
                    
                        <conditions>
                            <condition
                                field="selections"
                                scope="roster"
                                value="1"
                                percentValue="false"
                                shared="false"
                                includeChildSelections="true"
                                includeChildForces="false"
                                childId="battle-small"
                                type="atLeast"/>
                        </conditions>
                    </modifier>
                </modifiers>
        </selectionEntry>

        <!-- ========================= -->
        <!--    ARCHERS                -->
        <!-- ========================= -->

            <selectionEntry
                id="unit-archers"
                name="Archers"
                hidden="false"
                type="unit"
                import="true">

                <profiles>
                    <profile
                        id="prof-archers"
                        name="Archers"
                        hidden="false"
                        typeId="unit-profile"
                        typeName="Unit Profile">
    
                        <characteristics>
                            <characteristic
                                id="char-value-att-archers"
                                typeId="char-att"
                                name="Attacks">3/1
                            </characteristic>
    
                            <characteristic
                                id="char-value-range-archers"
                                typeId="char-range"
                                name="Range">30cm
                            </characteristic>

                            <characteristic
                                id="char-value-hits-archers"
                                typeId="char-hits"
                                name="Hits">3
                            </characteristic>

                            <characteristic
                                id="char-value-arm-archers"
                                typeIdtypeId="char-arm"
                                name="Armor">6+
                            </characteristic>

                            <characteristic
                                id="char-value-size-archers"
                                typeId="char-size"
                                name="Size">3
                            </characteristic>

                            <characteristic
                                id="char-value-special-archers"
                                typeId="char-special"
                                name="Special Rules">Archers. High Elf archers add +1 to their dice rolls when making Shooting attacks. They will therefore score a hit against targets in the open on a 3 or more, against targets that are defended on a 4 or more, and against fortified targets on a 5 or more.
                            </characteristic>
                        </characteristics>
                    </profile>
                </profiles>

                <costs>
                    <cost
                        id="cost-archers"
                        typeId="points"
                        name="pts"
                        value="75.0"/>
                    </costs>
            <categoryLinks>
                <categoryLink
                    id="category-archers"
                    name="Infantry"
                    targetId="cat-inf"
                    primary="true"
                    hidden="false"/>
                </categoryLinks>
            </selectionEntry>
        </sharedSelectionEntries>

        <!-- ========================= -->
        <!--    SILVER HELMS           -->
        <!-- ========================= -->

            <selectionEntry
                id="unit-silver"
                name="Silver Helms"
                hidden="false"
                type="unit"
                import="true">

                <profiles>
                    <profile
                        id="prof-silver"
                        name="Silver Helms"
                        hidden="false"
                        typeId="unit-profile"
                        typeName="Unit Profile">
    
                        <characteristics>
                            <characteristic
                                id="char-value-att-silver"
                                typeId="char-att"
                                name="Attacks">3
                            </characteristic>

                            <characteristic
                                id="char-value-hits-silver"
                                typeId="char-hits"
                                name="Hits">3
                            </characteristic>

                            <characteristic
                                id="char-value-arm-silver"
                                typeIdtypeId="char-arm"
                                name="Armor">4+
                            </characteristic>

                            <characteristic
                                id="char-value-size-silver"
                                typeId="char-size"
                                name="Size">3
                            </characteristic>
                        </characteristics>
                    </profile>
                </profiles>

                <costs>
                    <cost
                        id="cost-archers"
                        typeId="points"
                        name="pts"
                        value="110.0"/>
                    </costs>
            
            <categoryLinks>
                <categoryLink
                    id="category-silver"
                    name="Cavalry"
                    targetId="cat-cav"
                    primary="true"
                    hidden="false"/>
                </categoryLinks>
            </selectionEntry>
        </sharedSelectionEntries>

    <!-- ========================= -->
    <!-- BATTLE SIZE               -->
    <!-- ========================= -->

    <sharedSelectionEntryGroups>

        <selectionEntryGroup
            id="battle-size-group"
            name="Battle Size"
            hidden="false"
            collective="false"
            import="true">

<constraints>

    <constraint
        id="battle-size-min"
        field="selections"
        scope="parent"
        value="1"
        type="min"
        percentValue="false"/>

    <constraint
        id="battle-size-max"
        field="selections"
        scope="parent"
        value="1"
        type="max"
        percentValue="false"/>

</constraints>

            <selectionEntries>

                <selectionEntry
                    id="battle-small"
                    name="1000 pts — Small Battle"
                    hidden="false"
                    type="upgrade"
                    import="true">

                    <costs>
                        <cost
                            id="cost-battle-small"
                            typeId="points"
                            name="pts"
                            value="0.0"/>
                    </costs>

<modifiers>

    <modifier
        id="modifier-small-spearmen-min"
        type="set"
        field="min"
        value="2">

        <conditions>

            <condition
                field="selections"
                scope="roster"
                value="1"
                percentValue="false"
                shared="false"
                includeChildSelections="true"
                includeChildForces="false"
                childId="battle-small"
                type="instanceOf"/>

        </conditions>

    </modifier>

</modifiers>

                </selectionEntry>

                <selectionEntry
                    id="battle-standard"
                    name="2000 pts — Standard Battle"
                    hidden="false"
                    type="upgrade"
                    import="true">

                    <costs>
                        <cost
                            id="cost-battle-standard"
                            typeId="points"
                            name="pts"
                            value="0.0"/>
                    </costs>

                </selectionEntry>

                <selectionEntry
                    id="battle-large"
                    name="3000 pts — Large Battle"
                    hidden="false"
                    type="upgrade"
                    import="true">

                    <costs>
                        <cost
                            id="cost-battle-large"
                            typeId="points"
                            name="pts"
                            value="0.0"/>
                    </costs>

                </selectionEntry>

                <selectionEntry
                    id="battle-grand"
                    name="4000 pts — Grand Battle"
                    hidden="false"
                    type="upgrade"
                    import="true">

                    <costs>
                        <cost
                            id="cost-battle-grand"
                            typeId="points"
                            name="pts"
                            value="0.0"/>
                    </costs>

                </selectionEntry>

                <selectionEntry
                    id="battle-massive"
                    name="5000 pts — Massive Battle"
                    hidden="false"
                    type="upgrade"
                    import="true">

                    <costs>
                        <cost
                            id="cost-battle-massive"
                            typeId="points"
                            name="pts"
                            value="0.0"/>
                    </costs>

                </selectionEntry>

            </selectionEntries>

        </selectionEntryGroup>

    </sharedSelectionEntryGroups>


    <entryLinks>

        <entryLink
            id="link-battle-size"
            name="Battle Size"
            hidden="false"
            collective="false"
            import="true"
            type="selectionEntryGroup"
            targetId="battle-size-group"/>

<entryLink
    id="link-general"
    name="General"
    hidden="false"
    collective="false"
    import="true"
    type="selectionEntry"
    targetId="unit-general"/>

        <entryLink
            id="link-spearmen"
            name="Spearmen"
            hidden="false"
            type="selectionEntry"
            targetId="unit-spearmen"
            import="true"/>

        <entryLink
            id="link-archers"
            name="Archers"
            hidden="false"
            type="selectionEntry"
            targetId="unit-archers"
            import="true"/>

    </entryLinks>
</catalogue>
