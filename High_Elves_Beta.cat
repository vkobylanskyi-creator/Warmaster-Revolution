                            typeId="char-com"
                            name="Command">8
                        </characteristic>

                        <characteristic
                            id="char-value-size-hero"
                            typeId="char-size"
                            name="Size">1
                        </characteristic>
                
                    </characteristics>
                </profile>
            </profiles>

            <costs>
                <cost
                    id="cost-hero"
                    typeId="points"
                    name="pts"
                    value="80.0"/>
            </costs>

            <categoryLinks>
                <categoryLink
                    id="category-hero"
                    name="Characters"
                    targetId="cat-char"
                    primary="true"
                    hidden="false"/>
            </categoryLinks>

            <constraints>
                <constraint
                    id="min-hero"
                    field="selections"
                    scope="roster"
                    value="0"
                    type="min"
                    percentValue="false"/>

                <constraint
                    id="max-hero"
                    field="selections"
                    scope="roster"
                    value="1"
                    type="max"
                    percentValue="false"/>
            </constraints>

