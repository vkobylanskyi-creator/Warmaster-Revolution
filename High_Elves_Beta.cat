                    typeName="Unit Profile">

                    <characteristics>
                        <characteristic
                            id="char-value-att-swordmasters"
                            typeId="char-att"
                            name="Attacks">4
                        </characteristic>

                        <characteristic
                            id="char-value-hits-swordmasters"
