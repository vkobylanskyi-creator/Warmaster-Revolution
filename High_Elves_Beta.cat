\<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<catalogue
    library="false"
    id="he-beta-cat"
    name="High Elves (Beta)"
    gameSystemId="wmr-sys"
    gameSystemRevision="2"
    revision="2"
    battleScribeVersion="2.03"
    type="catalogue"
    xmlns="http://www.battlescribe.net/schema/catalogueSchema">

    <sharedSelectionEntries>
        <!-- ========================= -->
        <!-- PROFILES                  -->
        <!--    GENERAL                -->
        <!-- ========================= -->

        <selectionEntry
            id="unit-general"
            name="General"
            hidden="false"
            type="unit"
            import="true">

            <profiles>
                <profile
                    id="prof-general"
                    name="General"
                    hidden="false"
                    typeId="unit-profile"
                    typeName="Unit Profile">

                    <characteristics>
                        <characteristic
                            id="char-value-att-general"
                            typeId="char-att"
                            name="Attacks">+2
                        </characteristic>

                        <characteristic
                            id="char-value-com-general"
                            typeId="char-com"
                            name="Command">10
                        </characteristic>

                        <characteristic
                            id="char-value-size-general"
                            typeId="char-size"
                            name="Size">1
                        </characteristic>
                
                    </characteristics>
                </profile>
            </profiles>

            <costs>
                <cost
                    id="cost-general"
                    typeId="points"
                    name="pts"
                    value="180.0"/>
            </costs>

            <categoryLinks>
                <categoryLink
                    id="category-general"
                    name="Characters"
                    targetId="cat-char"
                    primary="true"
                    hidden="false"/>
            </categoryLinks>

            <constraints>
                <constraint
                    id="min-general"
                    field="selections"
                    scope="roster"
                    value="1"
                    type="min"
                    percentValue="false"/>

                <constraint
                    id="max-general"
                    field="selections"
                    scope="roster"
                    value="1"
                    type="max"
                    percentValue="false"/>
            </constraints>

<!-- ========================= -->
<!--    MOUNTS                 -->
<!-- ========================= -->
<selectionEntryGroups>
    <selectionEntryGroup 
        id="general-mounts" 
        name="Mount"
        hidden="false"
        collective="false"
        import="true">
        
        <constraints>
            <constraint
                id="general-mount-min"
                field="selections"
                scope="parent"
                value="0"
                type="min"
                percentValue="false"/>

                <constraint
                id="general-mount-max"
                field="selections"
                scope="parent"
                value="1"
                type="max"
                percentValue="false"/>
            </constraints>

    <!-- ========================= -->
    <!--    MOUNT GIANT EAGLE      -->
    <!-- ========================= -->
            <selectionEntries>
                <selectionEntry
                    id="mount-giant-eagle"
                    name="Giant Eagle"
                    hidden="false"
                    type="upgrade"
                    import="true">

                    <profiles>
                        <profile
                            id="profile-mount-giant-eagle"
                            name="Giant Eagle"
                            hidden="false"
                            typeId="unit-profile"
                            typeName="Unit Profile">

                            <characteristics>
                                <characteristic
                                    id="char-mount-giant-eagle-attacks"
                                    typeId="char-att"
                                    name="Attacks">+2
                                </characteristic>

                                <characteristic
                                    id="char-mount-giant-eagle-special"
                                    typeId="char-special"
                                    name="Special Rules">
Giant Eagle Mount. Generals, Wizards and Heroes can ride a Giant Eagle. An Eagle can fly increasing its rider‘s move from 60 to 100cm. An extra +2 Attacks are added to those of its rider.
                                </characteristic>
                            </characteristics>
                        </profile>
                    </profiles>

                    <costs>
                        <cost
                            id="cost-mount-giant-eagle"
                            typeId="points"
                            name="pts"
                            value="20.0"/>
                    </costs>
                </selectionEntry>

    <!-- ========================= -->
    <!--    MOUNT DRAGON           -->
    <!-- ========================= -->
                <selectionEntry
                    id="mount-dragon"
                    name="Dragon"
                    hidden="false"
                    type="upgrade"
                    import="true">

                    <profiles>
                        <profile
                            id="profile-mount-dragon"
                            name="Dragon"
                            hidden="false"
                            typeId="unit-profile"
                            typeName="Unit Profile">

                            <characteristics>
                                <characteristic
                                    id="char-mount-dragon-attacks"
                                    typeId="char-att"
                                    name="Attacks">+3
                                </characteristic>

                                <characteristic
                                    id="char-mount-dragon-special"
                                    typeId="char-special"
                                    name="Special Rules">
Dragons. Dragons can fly. Dragon Rider units and any other units that include a Dragon-riding character cause terror in their enemies.

Because Dragon Riders have a great many hits (6) which are difficult to inflict even during a lengthy combat engagement, we must consider the possibility of hurting the Dragon and reducing its effectiveness in subsequent turns. Therefore, if a Dragon Rider has accumulated 4-5 hits by the end of the Shooting phase or Combat phase and is no longer engaged in combat it is deemed to have been badly hurt. Once a Dragon has been badly hurt all accumulated hits are discounted and its maximum hits value and Attacks are halved for the rest of the battle (to 3 Hits and 3/2 Attacks).

Generals, Wizards and Heroes can ride Dragons. A Dragon can fly increasing its rider‘s move from 60 to 100cm. An extra +3 Attacks are added to those of its rider. A Dragon can breathe fire if the character has joined a unit that isn‘t engaged in combat. A Dragon ridden by a character can‘t breathe fire if it
is not part of a unit.

Dragons can make a fiery breath. This applies both to a unit of Dragon Riders and to Dragons ridden by characters that have joined a unit of troops. Fire Breath works as follows. The fire breath has a range of 20cm. Breath can be directed against one target as for normal shooting and has 3 Attacks that are worked out in the usual way at 4+ to hit.
                                </characteristic>
                            </characteristics>
                        </profile>
                    </profiles>

                    <costs>
                        <cost
                            id="cost-mount-dragon"
                            typeId="points"
                            name="pts"
                            value="100.0"/>
                    </costs>
                </selectionEntry>

    <!-- ========================= -->
    <!--    MOUNT CHARIOT          -->
    <!-- ========================= -->
                <selectionEntry
                    id="mount-chariot"
                    name="Chariot"
                    hidden="false"
                    type="upgrade"
                    import="true">

                    <profiles>
                        <profile
                            id="profile-mount-chariot"
                            name="Chariot"
                            hidden="false"
                            typeId="unit-profile"
                            typeName="Unit Profile">

                            <characteristics>
                                <characteristic
                                    id="char-mount-chariot-attacks"
                                    typeId="char-att"
                                    name="Attacks">+1
                                </characteristic>

                                <characteristic
                                    id="char-mount-giant-eagle-special"
                                    typeId="char-special"
                                    name="Special Rules">
Chariot Mount. Generals, Wizards and Heroes can ride Chariots. An extra +1 Attack is added to those of its rider.
                                </characteristic>
                            </characteristics>
                        </profile>
                    </profiles>

                    <costs>
                        <cost
                            id="cost-mount-chariot"
                            typeId="points"
                            name="pts"
                            value="5.0"/>
                    </costs>
                </selectionEntry>
            </selectionEntries>
    </selectionEntryGroup>
</selectionEntryGroups>
    </selectionEntry>

